local function getParent()
    local ok, result = pcall(function() return CoreGui end)
    if ok and result then
        local test = Instance.new("Folder")
        test.Parent = result
        test:Destroy()
        return result
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

