--// =========================
--// MINIMIZE / RESTORE
--// =========================
local isMinimized = false

local function minimizeWindow()
    if isMinimized then return end
    isMinimized = true

    TweenService:Create(Main, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { BackgroundTransparency = 1 }):Play()

    for _, v in ipairs(Main:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextButton") then
            TweenService:Create(v, TweenInfo.new(0.15), { TextTransparency = 1 }):Play()
        elseif v:IsA("Frame") and v.Name ~= "TopBar" then
            TweenService:Create(v, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
        end
    end

    task.wait(0.16)
    Main.Visible = false
    Minimized.Visible = true
end

local function restoreWindow()
    if not isMinimized then return end
    isMinimized = false

    Minimized.Visible = false
    Main.Visible = true

    local keep = { TopBar = true, Divider = true, NoKeyPill = true, FreeBadge = true }

    for _, v in ipairs(Main:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextButton") then
            v.TextTransparency = 1
        elseif v:IsA("Frame") and not keep[v.Name] then
            v.BackgroundTransparency = 1
        end
    end

    TweenService:Create(Main, TweenInfo.new(0.22), { BackgroundTransparency = 0 }):Play()
    for _, v in ipairs(Main:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextButton") then
            TweenService:Create(v, TweenInfo.new(0.22), { TextTransparency = 0 }):Play()
        elseif v:IsA("Frame") and not keep[v.Name] then
            TweenService:Create(v, TweenInfo.new(0.22), { BackgroundTransparency = 0 }):Play()
        end
    end
end

_G._DiscordMinimize = minimizeWindow
Minimized.MouseButton1Click:Connect(restoreWindow)

--// =========================
--// COPY LOGIC
--// =========================
local function tweenColor(obj, color, time)
    TweenService:Create(
        obj,
        TweenInfo.new(time or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { BackgroundColor3 = color }
    ):Play()
end

local function tryCopy(text)
    if setclipboard then
        local ok = pcall(setclipboard, text)
        if ok then return true end
    end
    if toclipboard then
        local ok = pcall(toclipboard, text)
        if ok then return true end
    end
    if writeclipboard then
        local ok = pcall(writeclipboard, text)
        if ok then return true end
    end
    return false
end

local resetting = false

local function onCopy()
    if resetting then return end
    tryCopy(DISCORD_LINK)

    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://6042053626"
    sound.Volume = 0.4
    sound.Parent = ScreenGui
    sound:Play()
    game:GetService("Debris"):AddItem(sound, 3)

    Button.Text = "✓  FREE LINK COPIED!"
    tweenColor(Button, COLORS.success, 0.15)
    Status.Text = "100% free, no key — see you in the server!"
    Status.TextColor3 = COLORS.success

    resetting = true
    task.wait(1.5)
    Button.Text = "CLICK HERE TO COPY THE LINK"
    tweenColor(Button, COLORS.accent, 0.25)
    Status.Text = ""
    resetting = false
end

Button.MouseButton1Click:Connect(onCopy)
Button.MouseEnter:Connect(function()
    if not resetting then tweenColor(Button, COLORS.hover) end
end)
Button.MouseLeave:Connect(function()
    if not resetting then tweenColor(Button, COLORS.accent) end
end)

Footer.MouseButton1Click:Connect(function()
    tryCopy(DISCORD_LINK)
    Status.Text = "Link copied — paste it in your browser!"
end)
Footer.MouseEnter:Connect(function()
    Footer.TextColor3 = COLORS.accent
end)
Footer.MouseLeave:Connect(function()
    Footer.TextColor3 = COLORS.subtext
end)

